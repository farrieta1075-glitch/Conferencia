# Auth.js (NextAuth v5)
# AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=
# URL pública del despliegue, p. ej. https://tu-proyecto.vercel.app
AUTH_URL=
AUTH_TRUST_HOST=true
# Formato: correo:contraseña:ROL,correo2:contraseña2:ROL
# Roles válidos: ADMIN, EDITOR, VIEWER
AUTH_USERS=

# Google Sheets (cuenta de servicio). No subas el JSON al repo.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_ID=
